msgid "Left shoulder is not detected clearly."
msgstr "El hombro izquierdo no se detecta claramente."

#: public/class-preview-ai-public.php:358
msgid "Right shoulder is not detected clearly."
msgstr "El hombro derecho no se detecta claramente."

